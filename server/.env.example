# =====================================================
# SERVER .env  →  Node.js server (server.js) uses this
# Place this file as:  deploy/server/.env
# =====================================================

# ── Server ───────────────────────────────────────────
PORT=3000

# ── Internal API URLs ────────────────────────────────
# These point to the Python servers running locally
PYTHON_API_URL=http://127.0.0.1:8000     # RAG API (api.py)
PIPELINE_API_URL=http://127.0.0.1:8001   # Pipeline API (production/pipeline_api.py)

# ── Admin Panel ──────────────────────────────────────
# Password to access /admin, /analytics, /content, /pipeline
ADMIN_PASSWORD=your-strong-password-here

# ── PostgreSQL Database ──────────────────────────────
# Used for: chat sessions, messages, handoffs, saved Q&A
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/bsa_chat
DATABASE_SSL=false                   # set 'true' for cloud providers (Render, Supabase)

# ── Optional ─────────────────────────────────────────
# CORS_ORIGINS=https://dealer1.com,https://dealer2.com   # restrict widget origins
# HISTORY_TURNS=5                                         # chat memory turns

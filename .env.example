# =====================================================
# ROOT .env  →  Python RAG API (api.py) uses this
# Place this file as:  deploy/.env
# =====================================================

# ── OpenAI ──────────────────────────────────────────
# Used for: embeddings, LLM answers, image cleaning
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Pinecone ─────────────────────────────────────────
# Used for: vector search (storing & retrieving manual chunks)
# Get from: https://app.pinecone.io
PINECONE_API_KEY=...
PINECONE_INDEX=bsa-chatbot          # your index name

# ── AWS S3 ───────────────────────────────────────────
# Used for: storing cleaned manual images
# Get from: https://aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=your-bucket-name
AWS_REGION=ap-southeast-2           # change to your region

# ── Optional Settings ────────────────────────────────
LEARNED_NAMESPACE=learned           # Pinecone namespace for saved Q&A
LEARNED_THRESHOLD=0.85              # similarity score to match saved answers
CONFIDENCE_THRESHOLD=0.45           # below this → suggest human handoff
